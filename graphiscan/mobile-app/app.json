{
  "expo": {
    "name": "GraphiScan",
    "slug": "graphiscan",
    "scheme": "graphiscan",
    "version": "1.0.0",
    "icon": "./assets/graphiscan-logo.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/graphiscan-logo.png"
      },
      "predictiveBackGestureEnabled": true,
      "icon": "./assets/graphiscan-logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Select a handwriting sample for screening.",
          "cameraPermission": "Photograph a handwriting sample for screening.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/graphiscan-logo.png"
    }
  }
}
