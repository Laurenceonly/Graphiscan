{
  "expo": {
    "name": "Graphiscan",
    "slug": "graphiscan",
    "scheme": "graphiscan",
    "version": "1.0.2",
    "icon": "./assets/graphiscan-logo.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "site.graphiscan.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/graphiscan-logo.png"
      },
      "predictiveBackGestureEnabled": true,
      "icon": "./assets/graphiscan-logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a handwriting sample or profile photo.",
          "cameraPermission": "Photograph a handwriting sample for screening.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar"
    ],
    "web": {
      "favicon": "./assets/graphiscan-logo.png"
    }
  }
}
