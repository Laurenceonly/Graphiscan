# Public API origin only. Never put database credentials or secret keys here.
# The hosted app uses public HTTPS on physical devices and emulators.
# This separate legacy origin applies only when API_MODE is explicitly legacy.
EXPO_PUBLIC_API_ORIGIN=http://127.0.0.1:5000
# Hosted is the default. Legacy requires an explicit opt-in for archival development.
EXPO_PUBLIC_API_MODE=hosted
EXPO_PUBLIC_HOSTED_API_ORIGIN=https://graphiscan-admin-api.onrender.com
