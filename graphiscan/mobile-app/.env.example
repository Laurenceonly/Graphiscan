# Public API origin only. Never put database credentials or secret keys here.
# Android emulator defaults to http://10.0.2.2:5000; web/iOS defaults to loopback.
# Physical devices require a reachable development LAN origin or deployed HTTPS API.
EXPO_PUBLIC_API_ORIGIN=http://127.0.0.1:5000
# Explicitly select hosted to use the v1 Auth/onboarding and screening read flow.
# Keep legacy until migration 012 and suitable issued-role accounts are ready.
EXPO_PUBLIC_API_MODE=legacy
EXPO_PUBLIC_HOSTED_API_ORIGIN=http://127.0.0.1:5002
