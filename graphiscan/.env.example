# Copy to .env and set unique local values. Never commit the filled .env file.
GRAPHISCAN_PASSWORD_PEPPER=
GRAPHISCAN_DB_HOST=localhost
GRAPHISCAN_DB_USER=
GRAPHISCAN_DB_PASSWORD=
GRAPHISCAN_DB_NAME=
GRAPHISCAN_SECRET_KEY=

# Optional v1 adapter. Leave backend blank to retain unavailable/503 behavior.
# Configure only against a reviewed disposable Supabase project with 001-005 applied.
# Direct DB role requires server-only SELECT/RLS access; TLS verifies hostname/CA.
GRAPHISCAN_V1_BACKEND=
GRAPHISCAN_V1_SUPABASE_URL=
GRAPHISCAN_V1_SUPABASE_PUBLISHABLE_KEY=
GRAPHISCAN_V1_DATABASE_URL=
# Optional password endpoint: requires reviewed 006 and a separate function-only
# graphiscan_password_writer login. Leave blank until hosted setup is verified.
GRAPHISCAN_V1_PASSWORD_DATABASE_URL=
# Optional hosted account-update endpoint: requires reviewed 017 and a separate
# function-only graphiscan_admin_writer login. Never use a service-role key here.
GRAPHISCAN_V1_ADMIN_DATABASE_URL=
# Optional account issuance only: reviewed migration018 plus a Supabase sb_secret_
# key kept on the Flask server. Never put it in VITE_/EXPO_PUBLIC_ or browser code.
GRAPHISCAN_V1_SUPABASE_AUTH_SECRET_KEY=
# Stable pagination signatures across hosted API instances: 32 random bytes in hex.
# Keep private; leave blank only for local development with restart-bound cursors.
GRAPHISCAN_V1_CURSOR_SECRET=
# Comma-separated exact HTTPS frontend origins for hosted_api.py.
GRAPHISCAN_CORS_ALLOWED_ORIGINS=
# Hosted factory requires the model/private Storage by default. Use false only
# for an explicitly admin-only preparation instance with screening unavailable.
GRAPHISCAN_REQUIRE_MODEL=true
# Optional, short-lived token for a fictional user in the disposable test project.
# Read only by tools/check_v1_hosted.py; never paste a token into chat/CLI flags.
GRAPHISCAN_V1_TEST_ACCESS_TOKEN=

# Hosted screening: reviewed 013/014, private bucket and separately supplied
# server-only S3 credentials. Never put these in VITE_/EXPO_PUBLIC_ variables.
GRAPHISCAN_V1_STORAGE_BUCKET=
GRAPHISCAN_V1_S3_ENDPOINT=
GRAPHISCAN_V1_S3_REGION=
GRAPHISCAN_V1_S3_ACCESS_KEY_ID=
GRAPHISCAN_V1_S3_SECRET_ACCESS_KEY=
# Path to a local artifact-hash manifest, NOT evidence of model evaluation.
GRAPHISCAN_V1_MODEL_MANIFEST=

# Needed only when running seed_admin.py or reset_admin.py.
GRAPHISCAN_ADMIN_EMAIL=
GRAPHISCAN_ADMIN_PASSWORD=
