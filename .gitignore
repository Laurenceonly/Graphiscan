# Local secrets and machine-specific configuration
**/.env
**/.env.*
!**/.env.example
graphiscan/config.py
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
**/google-services.json
**/GoogleService-Info.plist
**/local.properties

# Dependencies, caches, and builds
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/node_modules/
**/dist/
**/dist-ssr/
**/build/
**/.gradle/
*.apk
*.aab
*.log
/.local-tools/
/.local-backups/

# Private uploads, datasets, and generated ML artifacts
graphiscan/static/uploads/
/raw_dataset/
/dataset_image_split/
/model/
graphiscan/binary_raw/
graphiscan/binary_dataset/
graphiscan/training_results/
**/*.keras
**/*.h5
**/*.hdf5
**/*.tflite

# Database exports can contain student records and password hashes.
**/*.sql
!graphiscan/db/legacy_mysql_schema.sql
!graphiscan/db/postgres/*.sql

# Local editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.local
